{
  "devDependencies": {
    "playwright-core": "1.61.1",
    "wrangler": "4.157.0"
  },
  "name": "reward-radar",
  "version": "1.0.0",
  "scripts": {
    "build": "node site/build.mjs",
    "test": "python3 -m unittest discover -s tests && node --test tests/*.test.mjs",
    "dev": "wrangler dev --ip 127.0.0.1",
    "deploy": "wrangler deploy",
    "test:browser": "node tests/browser.mjs",
    "test:analytics": "node tests/analytics-browser.mjs",
    "test:ux": "node tests/ux-browser.mjs",
    "test:seo": "node tests/seo-browser.mjs"
  },
  "private": true
}
