{
  "name": "reward-radar",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "main": "./site/worker.mjs",
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
